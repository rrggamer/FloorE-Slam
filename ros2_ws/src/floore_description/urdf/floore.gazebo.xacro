<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Gazebo Sim (Harmonic, gz-sim8) system plugins. Loaded on the model
       itself via sdformat's URDF->SDF <gazebo> passthrough. -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>${track_width}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <enable_odom_tf>true</enable_odom_tf>

      <!-- Without limits, DiffDrive snaps wheel velocity straight to
           whatever cmd_vel says on the very next physics step. That's fine
           at speed, but confirmed (empirically, via /ground_truth roll/
           pitch logging) to combine badly with a chassis that's still
           settling right after spawn: a full-speed cmd hitting it during
           that brief wobble was enough to flip it, even though the same
           command a second later, once settled, was fine. Ramping instead
           of snapping removes that compounding effect. -->
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>

    <!-- DiffDrive's own /odom above is a wheel-kinematic *estimate* (it
         integrates commanded wheel velocity, like a real robot's wheel
         encoders would) and drifts from the true pose over a long,
         turn-heavy run: this is what caused the same wall to show up at
         several slightly different places/angles in the OCGM. This plugin
         instead reads the model's actual physics pose every frame, so it
         can't drift; it's the Gazebo equivalent of the CoppeliaSim
         assignment's sim.getObjectPosition()/sim.getObjectOrientation()
         ground truth. record_data.py uses this topic, not /odom. -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>ground_truth</odom_topic>
      <tf_topic>ground_truth_tf</tf_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>
  </gazebo>

  <!-- URDF <material><color> above covers RViz; gz-sim needs its own
       copy since sdformat's URDF->SDF conversion doesn't reliably carry
       the URDF material color through to the render engine. -->
  <gazebo reference="base_link">
    <material>
      <ambient>${chassis_color_rgba}</ambient>
      <diffuse>${chassis_color_rgba}</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
    </material>
  </gazebo>
  <gazebo reference="front_left_wheel_link">
    <material>
      <ambient>${wheel_color_rgba}</ambient>
      <diffuse>${wheel_color_rgba}</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
    </material>
  </gazebo>
  <gazebo reference="front_right_wheel_link">
    <material>
      <ambient>${wheel_color_rgba}</ambient>
      <diffuse>${wheel_color_rgba}</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
    </material>
  </gazebo>
  <gazebo reference="rear_left_wheel_link">
    <material>
      <ambient>${wheel_color_rgba}</ambient>
      <diffuse>${wheel_color_rgba}</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
    </material>
  </gazebo>
  <gazebo reference="rear_right_wheel_link">
    <material>
      <ambient>${wheel_color_rgba}</ambient>
      <diffuse>${wheel_color_rgba}</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
    </material>
  </gazebo>

  <!-- 2D LiDAR. type=gpu_lidar requires the world-level Sensors system
       plugin (added in the world SDF, not here) to actually produce data. -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

</robot>
