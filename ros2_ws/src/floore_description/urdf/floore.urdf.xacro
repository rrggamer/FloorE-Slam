<?xml version="1.0"?>
<robot name="floore" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================
       Dimensions
       All measured directly from meshes/collision/Chassis.STL and
       wheel_*.STL, which are now exported from the SolidWorks
       ASSEMBLY (Robot.SLDASM) with "save each component as a
       separate file", so all five meshes share one common,
       already-correct assembly frame, so no per-part recentering or
       mirroring needed, unlike the earlier per-part-only export.
       ============================================================ -->

  <!-- SolidWorks STL export units are mm; URDF/Gazebo use meters -->
  <xacro:property name="mesh_scale" value="0.001 0.001 0.001"/>

  <!-- measured: wheel_*.STL bounding box -> diameter ~225.7mm, width 51mm -->
  <xacro:property name="wheel_radius" value="0.1128"/>
  <xacro:property name="wheel_width" value="0.051"/>

  <!-- measured: Chassis.STL bounding box, in the shared assembly frame -->
  <xacro:property name="chassis_x_min" value="-0.21378"/>
  <xacro:property name="chassis_x_max" value="0.28105"/>
  <xacro:property name="chassis_y_min" value="-0.21582"/>
  <xacro:property name="chassis_y_max" value="0.21582"/>
  <xacro:property name="chassis_z_min" value="0.15349"/>
  <xacro:property name="chassis_z_max" value="0.75618"/>

  <!-- measured: average wheel-center position per axle/side, same
       assembly frame as the chassis above (see wheel_*.STL bounding
       boxes: front wheels share one X, rear wheels share another;
       left wheels share one Y, right wheels share another) -->
  <xacro:property name="wheel_front_x" value="0.123053"/>
  <xacro:property name="wheel_rear_x" value="-0.176977"/>
  <xacro:property name="wheel_left_y" value="0.185500"/>
  <xacro:property name="wheel_right_y" value="-0.185500"/>
  <xacro:property name="wheel_z" value="0.163165"/>

  <!-- derived, for reference and for the DiffDrive plugin's
       wheel_separation parameter (see floore.gazebo.xacro) -->
  <xacro:property name="wheelbase" value="${wheel_front_x - wheel_rear_x}"/>
  <xacro:property name="track_width" value="${wheel_left_y - wheel_right_y}"/>

  <!-- PLACEHOLDER: lidar mount point, top-center of the chassis
       bounding box. No lidar CAD/mesh exists yet so this is a
       primitive stand-in -->
  <xacro:property name="lidar_x" value="${(chassis_x_min + chassis_x_max) / 2}"/>
  <xacro:property name="lidar_y" value="${(chassis_y_min + chassis_y_max) / 2}"/>
  <xacro:property name="lidar_z" value="${chassis_z_max}"/>

  <xacro:property name="chassis_mass" value="8.0"/>
  <xacro:property name="wheel_mass" value="0.3"/>

  <!-- ============================================================
       base_link / chassis. base_link IS the chassis mesh's native
       assembly-frame origin, not recentered, so every joint below is
       just that same wheel's measured assembly-frame position.
       ============================================================ -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://floore_description/meshes/collision/Chassis.STL" scale="${mesh_scale}"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://floore_description/meshes/collision/Chassis.STL" scale="${mesh_scale}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${chassis_mass}"/>
      <origin xyz="${lidar_x} ${lidar_y} ${(chassis_z_min + chassis_z_max) / 2}" rpy="0 0 0"/>
      <inertia ixx="0.20" ixy="0.0" ixz="0.0" iyy="0.25" iyz="0.0" izz="0.30"/>
    </inertial>
  </link>

  <!-- ============================================================
       Wheel macro, fl/fr/rl/rr. Each wheel has its own mesh file,
       already positioned and oriented correctly for its own corner
       by the assembly export, so the only per-instance data needed
       is which mesh to load and where its measured center sits (the
       joint origin below IS that wheel's assembly-frame center; the
       visual's origin is the exact negative, so placing the link at
       the joint and then drawing the mesh at -center reconstructs
       the mesh's original absolute position).
       Wheel joint axis is Y: confirmed by the mesh bbox (X-extent ==
       Z-extent, Y is the thin tread width).
       ============================================================ -->
  <xacro:macro name="wheel" params="prefix mesh_file x y z">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="${-x} ${-y} ${-z}" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://floore_description/meshes/collision/${mesh_file}" scale="${mesh_scale}"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0015" ixy="0.0" ixz="0.0" iyy="0.0025" iyz="0.0" izz="0.0015"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="front_left"  mesh_file="wheel_front_left.STL"  x="${wheel_front_x}" y="${wheel_left_y}"  z="${wheel_z}"/>
  <xacro:wheel prefix="front_right" mesh_file="wheel_front_right.STL" x="${wheel_front_x}" y="${wheel_right_y}" z="${wheel_z}"/>
  <xacro:wheel prefix="rear_left"   mesh_file="wheel_rear_left.STL"   x="${wheel_rear_x}"  y="${wheel_left_y}"  z="${wheel_z}"/>
  <xacro:wheel prefix="rear_right"  mesh_file="wheel_rear_right.STL" x="${wheel_rear_x}"  y="${wheel_right_y}" z="${wheel_z}"/>

  <!-- ============================================================
       LiDAR (no CAD mesh yet, placeholder cylinder)
       ============================================================ -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.04"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.03" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${lidar_x} ${lidar_y} ${lidar_z}" rpy="0 0 0"/>
  </joint>

  <xacro:include filename="floore.gazebo.xacro"/>

</robot>
