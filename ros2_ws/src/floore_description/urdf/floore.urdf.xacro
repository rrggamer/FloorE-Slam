<?xml version="1.0"?>
<robot name="floore" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================
       Dimensions
       "measured" values come from the bounding box of the actual
       STL mesh (meshes/collision/*.STL, computed after the Z-up/
       X-front fix). "placeholder" values are NOT in the per-part
       STL data (wheel/chassis assembly mates only exist in the
       SolidWorks assembly, not in the individual part exports).
       Verify these against the real assembly and correct them
       before trusting odometry / collision behavior.
       ============================================================ -->

  <!-- SolidWorks STL export units are mm; URDF/Gazebo use meters -->
  <xacro:property name="mesh_scale" value="0.001 0.001 0.001"/>

  <!-- measured: Wheel.STL bounding box -> diameter ~225.7mm, width 51mm -->
  <xacro:property name="wheel_radius" value="0.1128"/>
  <xacro:property name="wheel_width" value="0.051"/>
  <!-- measured: Wheel.STL local origin sits at a corner of its bbox, not
       the disc center/axle, so this offset re-centers the mesh on the
       joint so the wheel doesn't render/collide shifted off its axle -->
  <xacro:property name="wheel_mesh_off_x" value="-0.11340"/>
  <xacro:property name="wheel_mesh_off_y" value="-0.02561"/>
  <xacro:property name="wheel_mesh_off_z" value="-0.11399"/>

  <!-- measured: Chassis.STL bounding box (its own origin sits ~at the
       bottom corner of the bbox, so base_link below is left at that
       same native origin rather than re-centered) -->
  <xacro:property name="chassis_length_x" value="0.4948"/>
  <xacro:property name="chassis_width_y" value="0.4316"/>
  <xacro:property name="chassis_height_z" value="0.6027"/>

  <!-- PLACEHOLDER: not derivable from per-part STLs; measure on the
       real robot / SolidWorks assembly and update -->
  <xacro:property name="wheelbase" value="0.40"/>
  <xacro:property name="track_width" value="0.36"/>
  <xacro:property name="wheel_z" value="${wheel_radius}"/>

  <!-- PLACEHOLDER: lidar mount point, currently just top-center of the
       chassis bounding box. No lidar CAD/mesh exists yet so this is a
       primitive stand-in -->
  <xacro:property name="lidar_x" value="${chassis_length_x/2}"/>
  <xacro:property name="lidar_y" value="${chassis_width_y/2}"/>
  <xacro:property name="lidar_z" value="${chassis_height_z}"/>

  <xacro:property name="chassis_mass" value="8.0"/>
  <xacro:property name="wheel_mass" value="0.3"/>

  <!-- ============================================================
       base_link / chassis
       ============================================================ -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://floore_description/meshes/collision/Chassis.STL" scale="${mesh_scale}"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://floore_description/meshes/collision/Chassis.STL" scale="${mesh_scale}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${chassis_mass}"/>
      <origin xyz="${chassis_length_x/2} ${chassis_width_y/2} ${chassis_height_z/2}" rpy="0 0 0"/>
      <inertia ixx="0.20" ixy="0.0" ixz="0.0" iyy="0.25" iyz="0.0" izz="0.30"/>
    </inertial>
  </link>

  <!-- ============================================================
       Wheel macro, fl/fr/rl/rr, mirrored about X (front/rear) and
       Y (left/right). Wheel joint axis is Y: confirmed by the mesh
       bbox (X-extent == Z-extent, Y is the thin tread width), so the
       wheel already spins about Y with no extra mesh rotation needed.
       ============================================================ -->
  <xacro:macro name="wheel" params="prefix x_sign y_sign">
    <!--
      Wheel.STL was modeled as a single (right-side) wheel, so it's
      correct as-is for y_sign=-1 but needs mirroring across its own Y
      plane for the left side (y_sign=1). Mirroring, not a rotation,
      is what's needed here since the hub/tread detail must face
      inward on both sides; a negative Y scale mirrors the mesh, and
      the recentering offset has to flip sign along with it or the
      mirrored copy ends up off-center from the joint again.
    -->
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="${wheel_mesh_off_x} ${wheel_mesh_off_y*(-1*y_sign)} ${wheel_mesh_off_z}" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://floore_description/meshes/collision/Wheel.STL" scale="0.001 ${0.001*(-1*y_sign)} 0.001"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0015" ixy="0.0" ixz="0.0" iyy="0.0025" iyz="0.0" izz="0.0015"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${chassis_length_x/2 + x_sign*wheelbase/2} ${chassis_width_y/2 + y_sign*track_width/2} ${wheel_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="front_left"  x_sign="1"  y_sign="1"/>
  <xacro:wheel prefix="front_right" x_sign="1"  y_sign="-1"/>
  <xacro:wheel prefix="rear_left"   x_sign="-1" y_sign="1"/>
  <xacro:wheel prefix="rear_right"  x_sign="-1" y_sign="-1"/>

  <!-- ============================================================
       LiDAR (no CAD mesh yet, placeholder cylinder)
       ============================================================ -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.04"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.03" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${lidar_x} ${lidar_y} ${lidar_z}" rpy="0 0 0"/>
  </joint>

  <xacro:include filename="floore.gazebo.xacro"/>

</robot>
