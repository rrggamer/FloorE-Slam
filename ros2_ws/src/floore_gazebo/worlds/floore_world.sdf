<?xml version="1.0"?>
<sdf version="1.10">
  <world name="floore_world">

    <!--
      Defining a <gui> block replaces gz-sim's default GUI plugin set
      entirely (it doesn't merge with it), so everything normally present,
      including the 3D view, view controls, world control/stats, entity
      tree, and inspector, has to be listed explicitly here too, alongside
      the one we actually wanted: VisualizeLidar draws the scan rays in
      the 3D view. Without it the sensor still runs and publishes /scan
      correctly, there's just no ray overlay in the Gazebo window itself.
    -->
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <camera_pose>-3 -3 3 0 0.3 0.78</camera_pose>
      </plugin>
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
        <use_event>true</use_event>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>
      <plugin filename="VisualizeLidar" name="Visualize Lidar">
      </plugin>
      <!-- Drag the gizmo on a selected object to move/rotate it -->
      <plugin filename="TransformControl" name="Transform control">
        <gz-gui>
          <title>Transform control</title>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">230</property>
          <property key="height" type="double">50</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <!-- Browse/insert new Fuel or local models straight into the scene -->
      <plugin filename="ResourceSpawner" name="Resource Spawner">
        <gz-gui>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>
      <plugin filename="ComponentInspector" name="Component inspector">
        <gz-gui>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>
      <plugin filename="EntityTree" name="Entity tree">
        <gz-gui>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>
    </gui>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!--
      Map.STL is the environment (floor + walls), exported in mm, scaled
      down 1:1000 here to meters. Loaded via GZ_SIM_RESOURCE_PATH pointing
      at the floore_description share dir (set in gazebo.launch.py) so
      this world doesn't need to know the actual install path.
    -->
    <model name="floor_environment">
      <static>true</static>
      <link name="map_link">
        <visual name="map_visual">
          <geometry>
            <mesh>
              <uri>model://floore_description/meshes/collision/Map.STL</uri>
              <scale>0.001 0.001 0.001</scale>
            </mesh>
          </geometry>
          <!--
            The floor face's normals are inverted in the STL itself (measured
            directly on the mesh: triangles near Z=0 have their normal
            pointing -Z, i.e. away from the room, while the wall-top
            triangles near Z=5m correctly point +Z). Ogre2 backface-culls
            single-sided geometry by default, so the floor was either
            invisible or lit wrong. double_sided renders it regardless of
            which way the normal points; fix the normal in SolidWorks and
            re-export if you want to drop this workaround later.
          -->
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
            <double_sided>true</double_sided>
          </material>
        </visual>
        <collision name="map_collision">
          <geometry>
            <mesh>
              <uri>model://floore_description/meshes/collision/Map.STL</uri>
              <scale>0.001 0.001 0.001</scale>
            </mesh>
          </geometry>
        </collision>
      </link>
    </model>

    <!--
      Furniture pulled from the Gazebo Fuel OpenRobotics collection (free,
      no local meshes needed, gz-sim downloads and caches each model on
      first load). Positions are placed using each model's actual
      downloaded-mesh bounding box (measured with trimesh after the first
      load, since the first attempt at this without real dimensions
      caused overlapping-collision ODE warnings): dining table
      1.0x2.35x0.74m, dining chair 0.43x0.54x0.96m, office desk
      0.87x2.26x1.22m, office chair 0.90x0.86x1.10m, sofa 1.8x1.04x0.94m,
      coffee table 0.73x0.73x0.37m (post-scale). Gaps below are sized
      with real margin against those, not guessed.
    -->

    <!-- spawn room (x:0-16, y:0-6); table rotated 90 deg so its long
         (2.35m) axis runs along the room's long X dimension -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Dining Table</uri>
      <name>dining_table</name>
      <pose>15 13 0.5 0 0 1.5708</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Dining Chair</uri>
      <name>dining_chair_1</name>
      <pose>13 13 0.5 0 0 1.5708</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Dining Chair</uri>
      <name>dining_chair_2</name>
      <pose>17.0 13 0.5 0 0 -1.5708</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sofa</uri>
      <name>sofa</name>
      <pose>1.5 4.2 0.5 0 0 4.71239</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/CoffeeTable</uri>
      <name>coffee_table</name>
      <pose>3 4.3 0.5 0 0 0</pose>
    </include>

    <!-- left room (x:0-5, y:10-20) -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Office Desk</uri>
      <name>office_desk</name>
      <pose>3.2 15 0.5 0 0 -1.570800</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Office Chair</uri>
      <name>office_chair</name>
      <pose>2.5 14 0.5 0 0 -1.5708</pose>
    </include>

    <include>
      <uri>
      https://fuel.gazebosim.org/1.0/OpenRobotics/models/Bed
      </uri>
      <name>bed</name>
      <pose>22 18 0.5 0 0 0</pose>
    </include>

    <include>
      <uri>
      https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sofa
      </uri>
      <name>sofa_tv</name>
      <pose>25 18 1.5 0 0 -1.5708</pose>
    </include>

    <include>
      <uri>
      https://fuel.gazebosim.org/1.0/OpenRobotics/models/Bathtub
      </uri>
      <name>bathtub</name>
      <pose>34 15.5 0.5 0 0 0</pose>
    </include>

    <include>
      <uri>
      https://fuel.gazebosim.org/1.0/OpenRobotics/models/Standard Toilet
      </uri>
      <name>toilet</name>
      <pose>36 16 0.5 0 0 0</pose>
    </include>
  
    <include>
      <uri>
      https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oven
      </uri>
      <name>oven</name>
      <pose>19 18 0.5 0 0 -3.14159</pose>
    </include>

    <include>
      <uri>
      https://fuel.gazebosim.org/1.0/OpenRobotics/models/Refrigerator
      </uri>
      <name>fridge</name>
      <pose>19 19 0.5 0 0 -3.14159</pose>
    </include>

    <include>
      <uri>
      https://fuel.gazebosim.org/1.0/OpenRobotics/models/Vanity
      </uri>
      <name>kitchen_sink</name>
      <pose>19 16.8 0.5 0 0 -1.5708</pose>
    </include>


    <include>
      <uri>
      https://fuel.gazebosim.org/1.0/OpenRobotics/models/Piano
      </uri>
      <name>piano</name>
      <pose>14 24 0.5 0 0 -1.5708</pose>
    </include>


  </world>
</sdf>
